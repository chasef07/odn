# Site Configuration (for SEO and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://onlinedoctornote.com  # Change to your production domain

# Database Configuration
# PostgreSQL connection string (used for both production and tests)
DATABASE_URL="postgres://user:password@host:5432/database"
PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key"

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_FRIENDS_FAMILY_PRICE_ID=price_your_discounted_price_id_here


# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Resend Webhook Configuration
# Get from: https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Cron Job Security
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Better Auth Configuration
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000  # Change to https://your-domain.com in production

# Doctor Information (for PDF generation)
# Used to populate doctor's note PDFs
DOCTOR_NAME="Dr. John Smith"
DOCTOR_CREDENTIALS="MD FACEP"
DOCTOR_NPI="1558307702"
DOCTOR_SIGNATURE_URL="/images/doctor-signature.png"
