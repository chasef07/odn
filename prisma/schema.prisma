// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL") // Prisma Accelerate connection
  directUrl = env("DATABASE_URL") // Direct connection for migrations
}

// Enums
enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  DENIED
  MAYBE
  MANUAL
}

enum NoteVerificationStatus {
  ACTIVE
  REVOKED
}

// Better Auth - User table (admin/doctor accounts)
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  accounts            Account[]
  sessions            Session[]
  reviewedSubmissions Submission[] @relation("ReviewedByUser")

  @@map("users")
}

// Better Auth - Account table (stores passwords and OAuth data)
model Account {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  accountId    String    @map("account_id")
  providerId   String    @map("provider_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  idToken      String?   @map("id_token")
  expiresAt    DateTime? @map("expires_at")
  password     String? // bcrypt hashed password

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for performance
  @@index([userId])
  @@index([userId, providerId])
  @@map("accounts")
}

// Better Auth - Session table
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for performance
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Temporary storage during payment processing
model TemporarySubmission {
  id              String   @id @default(uuid())
  paymentIntentId String   @unique @map("payment_intent_id")
  formData        Json     @map("form_data")
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("temporary_submissions")
}

// Permanent submission storage
model Submission {
  // Primary Keys & IDs
  id                    String  @id @default(uuid())
  stripePaymentIntentId String  @unique @map("stripe_payment_intent_id")
  paymentAmount         Int?    @map("payment_amount")
  offerCode             String? @map("offer_code")
  offerPriceId          String? @map("offer_price_id")

  // Status Tracking
  status SubmissionStatus @default(PENDING_REVIEW)

  // State Selection
  state String

  // Patient Information
  recipient          String // 'myself' or 'someone_else'
  patientFirstName   String   @map("patient_first_name")
  patientLastName    String   @map("patient_last_name")
  patientDateOfBirth DateTime @map("patient_date_of_birth") @db.Date

  // Guardian Information (conditional - only if recipient = 'someone_else')
  guardianFirstName   String?   @map("guardian_first_name")
  guardianLastName    String?   @map("guardian_last_name")
  guardianDateOfBirth DateTime? @map("guardian_date_of_birth") @db.Date

  // Contact Information
  email             String
  phone             String
  smsOptIn          Boolean   @default(false) @map("sms_opt_in")
  smsOptInAt        DateTime? @map("sms_opt_in_at")
  smsConsentVersion String?   @map("sms_consent_version")
  smsPhoneE164      String?   @map("sms_phone_e164")

  // Note Details
  notePurpose      String  @map("note_purpose") // 'work', 'school', 'both', 'other'
  otherNotePurpose String? @map("other_note_purpose")

  // Absence Dates
  firstDayOff DateTime @map("first_day_off") @db.Date
  lastDayOff  DateTime @map("last_day_off") @db.Date

  // Absence Reason
  absenceReason      String  @map("absence_reason")
  otherAbsenceReason String? @map("other_absence_reason")

  // Symptoms (conditional - array of strings)
  symptoms         Json? // ["Fever", "Cough", "Fatigue"]
  otherSymptomText String? @map("other_symptom_text")

  // Additional Information
  additionalInformation String? @map("additional_information") @db.Text

  // Admin Review Fields (filled when doctor reviews)
  reviewedAt        DateTime? @map("reviewed_at")
  reviewedByAdminId String?   @map("reviewed_by_admin_id")
  reviewedByUser    User?     @relation("ReviewedByUser", fields: [reviewedByAdminId], references: [id])

  // Denial Information (only if status = DENIED)
  denialReason String? @map("denial_reason") // selectable: "Legal", "7+ days", "Duplicate", "Refund (Customer)", "Refund (Denial)", "Under 18", or "Other"; legacy rows may contain "Refund"

  // Maybe Review Information (only if status = MAYBE)
  maybeReason       String?   @map("maybe_reason")
  maybeInternalNote String?   @map("maybe_internal_note") @db.Text
  maybeApprovedDays Int?      @map("maybe_approved_days")
  maybeEmailSentAt  DateTime? @map("maybe_email_sent_at")

  // Refund Tracking
  stripeRefundId String?   @map("stripe_refund_id") // "re_1ABC123..."
  refundedAt     DateTime? @map("refunded_at") // When refund was initiated

  // Email Delivery Tracking
  approvalEmailSentAt DateTime? @map("approval_email_sent_at")
  denialEmailSentAt   DateTime? @map("denial_email_sent_at")

  // PDF approval render options used when a support automation reissues a note
  approvalDiagnosis        String?  @map("approval_diagnosis") @db.Text
  approvalWithRestrictions Boolean? @map("approval_with_restrictions")

  // Public note verification snapshot
  noteVerifications NoteVerification[]
  smsMessages       SmsMessage[]
  smsSupportTickets SmsSupportTicket[]

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([patientFirstName, patientLastName, patientDateOfBirth, status])
  @@index([email, status])
  @@index([smsPhoneE164])
  @@index([offerCode])
  @@map("submissions")
}

model SmsPhoneState {
  phoneE164   String    @id @map("phone_e164")
  optedOutAt  DateTime? @map("opted_out_at")
  lastOptInAt DateTime? @map("last_opt_in_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("sms_phone_states")
}

model SmsMessage {
  id                String            @id @default(uuid())
  submissionId      String?           @map("submission_id")
  submission        Submission?       @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  supportTicketId   String?           @map("support_ticket_id")
  supportTicket     SmsSupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  type              String
  direction         String
  to                String?
  from              String?
  body              String            @db.Text
  providerMessageId String?           @unique @map("provider_message_id")
  providerStatus    String?           @map("provider_status")
  errorCode         String?           @map("error_code")
  errorMessage      String?           @map("error_message") @db.Text
  supportHandledAt  DateTime?         @map("support_handled_at")
  sentAt            DateTime?         @map("sent_at")
  receivedAt        DateTime?         @map("received_at")
  finalizedAt       DateTime?         @map("finalized_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([submissionId])
  @@index([supportTicketId])
  @@index([type])
  @@index([providerStatus])
  @@index([createdAt])
  @@map("sms_messages")
}

model SmsSupportTicket {
  id               String      @id @default(uuid())
  phoneE164        String      @map("phone_e164")
  submissionId     String?     @map("submission_id")
  submission       Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  status           String
  category         String?
  state            String
  source           String
  automationKind   String?     @map("automation_kind")
  automationStatus String?     @map("automation_status")
  collectedData    Json?       @map("collected_data")
  adminSummary     String?     @map("admin_summary") @db.Text
  failureReason    String?     @map("failure_reason") @db.Text
  retryCount       Int         @default(0) @map("retry_count")
  csrAlertedAt     DateTime?   @map("csr_alerted_at")
  lastInboundAt    DateTime?   @map("last_inbound_at")
  lastOutboundAt   DateTime?   @map("last_outbound_at")
  closedAt         DateTime?   @map("closed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  messages SmsMessage[]
  jobs     SmsSupportJob[]

  @@index([phoneE164])
  @@index([submissionId])
  @@index([status, updatedAt])
  @@index([category])
  @@index([automationStatus])
  @@map("sms_support_tickets")
}

model SmsSupportJob {
  id          String           @id @default(uuid())
  ticketId    String           @map("ticket_id")
  ticket      SmsSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind        String
  status      String
  payload     Json?
  attempts    Int              @default(0)
  lockedAt    DateTime?        @map("locked_at")
  lockedBy    String?          @map("locked_by")
  lastError   String?          @map("last_error") @db.Text
  runAfter    DateTime         @default(now()) @map("run_after")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@index([ticketId])
  @@map("sms_support_jobs")
}

model TelnyxWebhookEvent {
  id          String   @id
  eventType   String   @map("event_type")
  occurredAt  DateTime @map("occurred_at")
  status      String   @default("PROCESSED")
  lastError   String?  @map("last_error") @db.Text
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("telnyx_webhook_events")
}

model ResendWebhookEvent {
  id          String   @id
  emailId     String?  @map("email_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([emailId])
  @@map("resend_webhook_events")
}

model NoteVerification {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  medicalRecordNumber String                 @unique @map("medical_record_number")
  verificationSlug    String                 @unique @map("verification_slug")
  status              NoteVerificationStatus @default(ACTIVE)

  issueDate       DateTime @map("issue_date") @db.Date
  patientInitials String   @map("patient_initials")
  firstDayOff     DateTime @map("first_day_off") @db.Date
  lastDayOff      DateTime @map("last_day_off") @db.Date
  returnGuidance  String   @map("return_guidance")

  physicianName        String  @map("physician_name")
  physicianCredentials String  @map("physician_credentials")
  physicianNpi         String? @map("physician_npi")
  licenseState         String? @map("license_state")
  licenseNumber        String? @map("license_number")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
  @@map("note_verifications")
}
