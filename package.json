{
  "name": "onlinedoctornote",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
